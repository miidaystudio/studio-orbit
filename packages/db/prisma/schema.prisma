generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDIO_ADMIN
  CLIENT
}

enum ProjectStatus {
  ACTIVE
  IN_REVIEW
  COMPLETED
}

enum MilestoneStatus {
  UPCOMING
  IN_PROGRESS
  PENDING_APPROVAL
  APPROVED
}

enum PinStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
}

model Organization {
  id        String   @id @default(uuid())
  name      String   // e.g., "Orbit Studio"
  slug      String   @unique
  logoUrl   String?
  createdAt DateTime @default(now())

  users     User[]
  projects  Project[]
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  name           String
  role           Role          @default(CLIENT)
  avatarUrl      String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  comments       PinComment[]
}

model Project {
  id             String        @id @default(uuid())
  name           String
  clientName     String
  clientEmail    String
  clientToken    String        @unique @default(uuid()) // Magic workspace access token
  status         ProjectStatus @default(ACTIVE)
  budgetInCents  Int           @default(0)
  spentInCents   Int           @default(0)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  startDate      DateTime      @default(now())
  targetEndDate  DateTime
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  milestones     Milestone[]
  assets         Asset[]
  retainers      Retainer[]
  invoices       Invoice[]
}

enum ScopeType {
  IN_SCOPE
  OUT_OF_SCOPE
}

model Milestone {
  id                String          @id @default(uuid())
  projectId         String
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  dueDate           DateTime
  status            MilestoneStatus @default(UPCOMING)
  signedAt          DateTime?
  signedBy          String?
  signedByEmail     String?
  auditHash         String?         // Tamper-evident SHA-256 sign-off digest
  ipAddress         String?
  snapshotUrl       String?
  certificatePdfUrl String?
}

model Asset {
  id            String   @id @default(uuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String
  versionNumber Int      @default(1)
  imageUrl      String
  width         Int      @default(1920)
  height        Int      @default(1080)
  createdAt     DateTime @default(now())

  pins          CanvasPin[]
}

enum PinCategory {
  BUG
  CHANGE_REQUEST
  COPY_CHANGE
}

enum ClientApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  NOT_APPLICABLE
}

model MilestoneSignoff {
  id              String    @id @default(uuid())
  milestoneId     String
  milestone       Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  clientEmail     String
  clientIp        String
  commitHashOrUrl String?
  signedAt        DateTime  @default(now())
  signatureName   String
  auditHash       String
  certificatePdfUrl String?
}

model AuditLedgerEvent {
  id            String   @id @default(uuid())
  retainerId    String?
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  eventType     String   // SCOPE_DEDUCTION | INVOICE_PAYMENT | HOUR_TOPUP | MANUAL_ADJUSTMENT
  description   String
  hoursDelta    Float
  amountInCents Int?
  createdAt     DateTime @default(now())
}

model CanvasPin {
  id                  String               @id @default(uuid())
  assetId             String
  asset               Asset                @relation(fields: [assetId], references: [id], onDelete: Cascade)
  xPercent            Float                // 0-100 percentage relative to canvas width
  yPercent            Float                // 0-100 percentage relative to canvas height
  title               String
  status              PinStatus            @default(OPEN)
  
  // Triage & Scope Firewall
  pinCategory         PinCategory          @default(BUG)
  billableHours       Float?
  estimatedCostCents  Int?
  clientApprovalStatus ClientApprovalStatus @default(NOT_APPLICABLE)

  // Copy-Deck Sync
  originalText        String?
  updatedText         String?

  // DOM Anchor & Viewport Attributes
  selectorPath        String?              // Unique CSS Selector Path
  targetOffsetX       Float?               // Relative offset X within target element (0-1)
  targetOffsetY       Float?               // Relative offset Y within target element (0-1)
  domSnippet          String?              // Snippet of inner text for re-anchor heuristic
  viewportWidth       Int                  @default(1440)
  viewportHeight      Int                  @default(900)
  devicePixelRatio    Float                @default(1.0)
  userAgent           String?
  consoleLogs         String?              // Intercepted console errors/logs
  reanchorStatus      String?              @default("ANCHORED")

  // GitHub Bridge & Branch Tagging
  githubIssueNumber   Int?
  githubIssueUrl      String?
  prNumber            Int?
  previewUrl          String?

  // Scope Defense & Retainer Tracking
  scopeType           ScopeType            @default(IN_SCOPE)
  estimatedHours      Float                @default(0.0)
  estimatedCostInCents Int                 @default(0)
  stripePaymentUrl    String?

  createdAt           DateTime             @default(now())

  comments            PinComment[]
}

model PinComment {
  id        String    @id @default(uuid())
  pinId     String
  pin       CanvasPin @relation(fields: [pinId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime  @default(now())
}

model Retainer {
  id            String   @id @default(uuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  totalHours    Float
  usedHours     Float    @default(0)
  hourlyRate    Int      // rate in cents
  cycleStart    DateTime
  cycleEnd      DateTime
  createdAt     DateTime @default(now())
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNum    String        @unique
  projectId     String
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  amountInCents Int
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @default(now())
  dueDate       DateTime
  stripeId      String?
  createdAt     DateTime      @default(now())
}

model SprintShowcase {
  id                String    @id @default(uuid())
  clientId          String
  title             String
  versionTag        String
  stagingUrl        String
  status            String    @default("IN_REVIEW") // DRAFT | IN_REVIEW | APPROVED
  stops             Json      // array of scroll targets, hotspot coordinates, designer notes
  approvedAt        DateTime?
  approvalSignature String?
}

model DesignTokenPreset {
  id              String   @id @default(uuid())
  sprintId        String?
  name            String
  tokens          Json     // radii, fontScales, colorTokens: { background, primary, accent }
  createdByClient Boolean  @default(false)
}

model LaunchAudit {
  id          String   @id @default(uuid())
  stagingUrl  String
  score       Int      // 0 to 100
  metaDetails Json     // ogTitle, ogImage, ogDescription, canonicalUrl
  assetIssues Json     // array of overweight assets/uncompressed images
  scannedAt   DateTime @default(now())
}

model BrandVaultRule {
  id             String   @id @default(uuid())
  clientId       String
  approvedColors Json     // array of hex values
  approvedFonts  Json     // array of font families
  minHealthScore Int      @default(85)
  lastAuditScore Int?
}
