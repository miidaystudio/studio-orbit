# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://orbit:orbit_password@localhost:5432/studio_orbit?schema=public"

# Next.js Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Realtime WebSocket Service URL
NEXT_PUBLIC_REALTIME_WS_URL="ws://localhost:8080"

# Stripe Payments Integration (Optional)
STRIPE_SECRET_KEY="sk_test_mock_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_mock_webhook_secret"

# S3 / Cloudflare R2 Direct Uploads (Optional)
AWS_S3_BUCKET="studio-orbit-assets"
AWS_ACCESS_KEY_ID="mock_access_key"
AWS_SECRET_ACCESS_KEY="mock_secret_key"
AWS_REGION="us-east-1"
